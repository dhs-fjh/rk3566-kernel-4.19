&i2c2 {
	status = "okay";
	clock-frequency = <1000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2m0_xfer>;
	//添加你的I2C设备参考
	// gt1x: gt1x@14 {
	// 	compatible = "goodix,gt1x";
	// 	reg = <0x14>;
	// 	pinctrl-names = "default";
	// 	pinctrl-0 = <&touch_gpio>;
	// 	goodix,rst-gpio = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
