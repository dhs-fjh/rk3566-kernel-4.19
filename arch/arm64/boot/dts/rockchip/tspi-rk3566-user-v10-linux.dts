/* I2S3 M0：INMP441 双工引脚组（SDO 可悬空不接） */
&i2s3_2ch {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2s3m0_mclk
		     &i2s3m0_sclk
		     &i2s3m0_lrck
		     &i2s3m0_sdi
		     &i2s3m0_sdo>;
	rockchip,clk-trcm = <1>;
};

/* 勿与 inmp441_sound 同时使用 I2S3 */
&audiopwmout_diff {
	status = "disabled";
};

/* UART3 M1: UART3_TX_M1 / UART3_RX_M1 */
&uart3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart3m1_xfer>;
};
